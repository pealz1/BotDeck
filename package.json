{
  "name": "botdeck",
  "productName": "BotDeck",
  "version": "1.0.0",
  "description": "BotDeck: a desktop Discord bot client. Log in to Discord with a bot token and use your bot like a normal account.",
  "author": {
    "name": "pealz1",
    "url": "https://github.com/pealz1"
  },
  "contributors": [
    {
      "name": "aiko-chan-ai (Elysia)",
      "url": "https://github.com/aiko-chan-ai"
    }
  ],
  "homepage": "https://github.com/pealz1/BotDeck#readme",
  "bugs": {
    "url": "https://github.com/pealz1/BotDeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pealz1/BotDeck.git"
  },
  "license": "GPL-3.0",
  "main": "build/index.js",
  "scripts": {
    "test": "node --test tests/electron.test.cjs && npm run test:plugin",
    "test:plugin": "tsx --test tests/plugin/*.test.ts",
    "test:app": "npm run build:ts && npm run start",
    "test:app:vc": "npm run vencord && npm run build:ts && npm run start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json && tsc --noEmit --strict --skipLibCheck --target es2024 --module commonjs --moduleResolution node tests/settings-types.ts",
    "build:ts": "tsc && tsc-alias && npm run build:settings",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "vencord": "tsx scripts/vencordBuild.ts",
    "discohook": "tsx scripts/discohookBuild.ts",
    "core:update": "tsx scripts/update.ts",
    "start": "electron .",
    "mac": "electron-builder -m --publish never",
    "win": "electron-builder -w --publish never",
    "linux": "electron-builder -l --publish never",
    "build:bin": "electron-builder --publish never",
    "build": "npm run build:deps && npm run build:ts && npm run build:bin",
    "build:deps": "npm run vencord && npm run discohook",
    "requirement": "npm ci && tsx scripts/vencordClone.ts && tsx scripts/discohookClone.ts",
    "build:settings": "tsc -p tsconfig.renderer.json && vite build --config scripts/settingsVite.mts"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord-bot-client",
    "bot-token",
    "bot-login",
    "discord-client",
    "electron",
    "vencord",
    "desktop-app",
    "botdeck"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "@types/express": "^4.17.23",
    "@types/http-proxy": "^1.17.17",
    "@types/ini": "^4.1.1",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^28.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-header": "^1.2.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^29.1.1",
    "pnpm": "^11.17.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@sapphire/snowflake": "^3.5.5",
    "dexie": "^4.4.6",
    "discord-api-types": "^0.38.56",
    "discord-protos": "^1.2.357",
    "electron-context-menu": "^5.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "ini": "^6.0.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "murmurhash": "^2.0.1",
    "probe-image-size": "^7.4.0",
    "selfsigned": "^2.4.1",
    "undici": "^7.24.3"
  },
  "build": {
    "files": [
      "!docs",
      "!scripts",
      "!Vencord",
      "!src",
      "!tsconfig.json",
      "!tsup.config.ts",
      "!.eslintrc.json",
      "!.gitattributes",
      "!.gitignore",
      "!.prettierrc.json",
      "!eslint.config.mjs",
      "!readme.md",
      "assets",
      "assets/editor",
      "build",
      "VencordExtension",
      "!tsconfig.renderer.json",
      "!plans",
      "!plugin"
    ],
    "appId": "io.github.pealz1.botdeck",
    "productName": "BotDeck",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2022-2026 aiko-chan-ai and contributors; BotDeck © 2026 pealz1",
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "icon": "./assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs access to the microphone",
        "com.apple.security.device.audio-input": true
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "BotDeck",
          "GenericName": "Internet Messenger",
          "Type": "Application",
          "Categories": "Network;InstantMessaging;Chat;",
          "Keywords": "discord;bot;botdeck;vencord;electron;chat;"
        }
      },
      "category": "Network",
      "icon": "./assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "./LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pealz1",
        "repo": "BotDeck"
      }
    ],
    "asar": false
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  }
}
